# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Automated Task Manager"
API_PREFIX=/api
# development | test | production. Production deployments MUST set this —
# it gates the media-storage safety check below. Left as "development" for
# local/dev/CI so nothing here breaks existing setups by default.
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/task_manager

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── URLs & CORS ───────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Default Admin Seed ────────────────────────────────────────────────────────
# If set, a default admin account is created on startup (optional)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | anthropic | gemini | generic
LLM_PROVIDER=ollama
DEFAULT_MODEL=

# Ollama (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Generic OpenAI-compatible endpoint (e.g. LiteLLM, Azure OpenAI, local vLLM)
GENERIC_LLM_API_URL=
GENERIC_LLM_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Automated Task Manager"

# ── Media storage (user avatars, organization/project logos) ──────────────────
# local — writes under ./media, served by this app's own /media mount.
#         Fine for development/tests. NOT durable in production (lost on
#         restart/redeploy, inconsistent across multiple instances).
# s3    — durable, S3-compatible object storage. Required in production:
#         the app refuses to start with ENVIRONMENT=production and
#         MEDIA_STORAGE_BACKEND=local (see app/core/config.py).
MEDIA_STORAGE_BACKEND=local

# Required when MEDIA_STORAGE_BACKEND=s3. Works with real AWS S3 or any
# S3-compatible provider (Cloudflare R2, DigitalOcean Spaces, MinIO,
# Backblaze B2, ...) — see MEDIA_STORAGE.md for the full checklist.
# MEDIA_BUCKET=your-media-bucket-name
# AWS_REGION=us-east-1
# Set only for a non-AWS S3-compatible endpoint or a local test double;
# leave unset for real AWS S3.
# AWS_S3_ENDPOINT_URL=
# Optional CDN/custom-domain override for public object URLs.
# MEDIA_PUBLIC_BASE_URL=
#
# AWS credentials are intentionally NOT env vars here — boto3's own
# default credential chain (environment vars AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY, a shared ~/.aws/credentials profile, or an
# EC2/ECS/EKS instance/task role) supplies them. Prefer an instance/task
# role in production over long-lived access keys.

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Leave blank to inherit from REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Microsoft OAuth (optional) ────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# ── Stripe billing ────────────────────────────────────────────────────────────
# Create 8 recurring Prices in the Stripe Dashboard first (test mode to start):
# Starter monthly/annual, Business monthly/annual, Extra Team monthly/annual,
# Extra User monthly/annual — then paste their price_... IDs below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TRIAL_DAYS=14
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_EXTRA_TEAM_MONTHLY=
STRIPE_PRICE_EXTRA_TEAM_ANNUAL=
STRIPE_PRICE_EXTRA_USER_MONTHLY=
STRIPE_PRICE_EXTRA_USER_ANNUAL=
