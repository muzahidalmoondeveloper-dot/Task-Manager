# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Automated Task Manager"
API_PREFIX=/api

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/task_manager

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── URLs & CORS ───────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Default Admin Seed ────────────────────────────────────────────────────────
# If set, a default admin account is created on startup (optional)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | gemini | generic
LLM_PROVIDER=ollama
DEFAULT_MODEL=

# Ollama (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Generic OpenAI-compatible endpoint (e.g. LiteLLM, Azure OpenAI, local vLLM)
GENERIC_LLM_API_URL=
GENERIC_LLM_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Automated Task Manager"

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Leave blank to inherit from REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Microsoft OAuth (optional) ────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# ── Stripe billing ────────────────────────────────────────────────────────────
# Create 8 recurring Prices in the Stripe Dashboard first (test mode to start):
# Starter monthly/annual, Business monthly/annual, Extra Team monthly/annual,
# Extra User monthly/annual — then paste their price_... IDs below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TRIAL_DAYS=14
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_EXTRA_TEAM_MONTHLY=
STRIPE_PRICE_EXTRA_TEAM_ANNUAL=
STRIPE_PRICE_EXTRA_USER_MONTHLY=
STRIPE_PRICE_EXTRA_USER_ANNUAL=
